# === Qdrant ===
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=documents

# === Embedding ===
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_DEFAULT=5

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# === Transcript ===
TRANSCRIPT_SEQ_START=1
TRANSCRIPT_WINDOW_SIZE=2
TRANSCRIPT_MAX_WINDOW_SIZE=5
TRANSCRIPT_DEFAULT_COLLECTION=meeting_transcripts

# === Context Builder LLM ===
# Đặt "none" để tắt build context khi chưa có LLM
LLM_PROVIDER=none
LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
CONTEXT_MAX_TOKENS=800
CONTEXT_MAX_RETRY=2
CONTEXT_TIMEOUT_SECONDS=30
