# === Qdrant ===
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=documents

# === Embedding ===
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_DEFAULT=5

# === Redis (sequence + context cache) ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# === Transcript ===
TRANSCRIPT_SEQ_START=1
TRANSCRIPT_WINDOW_SIZE=2
TRANSCRIPT_MAX_WINDOW_SIZE=5
TRANSCRIPT_DEFAULT_COLLECTION=meeting_transcripts

# === Transcript storage layout (Phase 3 S2) ===
# shared (mặc định): tất cả cuộc họp → 1 Qdrant collection dùng chung → ít file descriptor
# per_meeting      : 1 collection / 1 cuộc họp (tương thích ngược Phase 1–2, dùng để test)
# sharded          : hash(meeting_id) % N shards (YAGNI — không bật nếu chưa đo cần thiết)
TRANSCRIPT_STORAGE_LAYOUT=shared
TRANSCRIPT_SHARED_COLLECTION=meeting_transcripts
TRANSCRIPT_NUM_SHARDS=8

# === Qdrant storage options (Phase 3 S1) ===
# on_disk=true: vector dùng memmap — không thường trú RAM, OS page cache lo hot/cold tự động
QDRANT_ON_DISK=true
QDRANT_ON_DISK_PAYLOAD=true

# === Context Builder LLM ===
# Provider: ollama | gemini | openai | none
# - "none": tắt build context (context_status sẽ ở "disabled")
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=http://ollama:11434
LLM_API_KEY=
CONTEXT_MAX_TOKENS=800
CONTEXT_MAX_RETRY=2
CONTEXT_TIMEOUT_SECONDS=30

# === Context Worker (Phase 3 B1) ===
# CONTEXT_WORKER_CONCURRENCY: số cuộc họp build context song song (FIFO vẫn đảm bảo trong mỗi cuộc)
# CONTEXT_RECOVERY_SCAN: lúc startup quét lại điểm pending/processing và enqueue lại
# WORKER_IDLE_TTL: worker của 1 cuộc họp tự dọn sau N giây không có job
CONTEXT_WORKER_CONCURRENCY=4
CONTEXT_RECOVERY_SCAN=true
WORKER_IDLE_TTL=600

# === Hybrid retrieval (fusion BM25 + vector — kiểu RAGFlow) — OPTIONAL ===
# Mặc định TẮT → truy vấn y hệt bản pure-vector. Bật để cải thiện khớp tên riêng/con số.
HYBRID_ENABLED=false
HYBRID_VECTOR_WEIGHT=0.7
HYBRID_TERM_WEIGHT=0.3
HYBRID_FETCH_MULTIPLIER=3
# Tokenizer BM25 (Phase 3 A1): simple | pyvi | underthesea
# pyvi cần: pip install pyvi  |  underthesea cần: pip install underthesea
HYBRID_TOKENIZER=simple

# === Reranker cross-encoder — OPTIONAL, gated như LLM ===
# Provider: none | local | http
# - "none"  : không rerank (mặc định, không load model)
# - "local" : sentence-transformers CrossEncoder (vd BAAI/bge-reranker-v2-m3)
# - "http"  : gọi endpoint rerank ngoài (TEI/Infinity/Xinference) qua RERANK_BASE_URL
RERANK_PROVIDER=none
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_BASE_URL=http://localhost:8080
RERANK_API_KEY=
RERANK_TIMEOUT_SECONDS=30
