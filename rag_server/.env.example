# === Qdrant ===
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=documents

# === Embedding ===
# Backend: sentence_transformers (dev/CPU/GPU) | qaic (NPU Qualcomm Cloud AI / AI080)
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIM=768
EMBEDDING_BACKEND=qaic
EMBEDDING_QPC_PATH=/duong/dan/qpc/e5-base    # thư mục QPC, hoặc trỏ thẳng file .bin
EMBEDDING_MAX_SEQ_LEN=128                    # PHẢI khớp seq_len lúc compile QPC

# Prefix bắt buộc của E5 (giữ nguyên dấu cách cuối; để "" nếu dùng model đối xứng như MiniLM cũ)
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_PASSAGE_PREFIX="passage: "
# Chỉ dùng khi EMBEDDING_BACKEND=qaic — trỏ tới thư mục QPC build bằng scripts/build_qpc.sh
# EMBEDDING_QPC_PATH=/opt/qpc/e5-base
# seq_len tĩnh phải khớp lúc compile QPC
EMBEDDING_MAX_SEQ_LEN=128
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_DEFAULT=5

# === Redis (sequence + context cache) ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# === Transcript ===
TRANSCRIPT_SEQ_START=1
TRANSCRIPT_WINDOW_SIZE=2
TRANSCRIPT_MAX_WINDOW_SIZE=5
TRANSCRIPT_DEFAULT_COLLECTION=meeting_transcripts

# === Context Builder LLM ===
# Provider: ollama | gemini | openai | none
# - "none": tắt build context (chỉ lưu transcript, context_status sẽ ở pending mãi)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=http://ollama:11434
LLM_API_KEY=
CONTEXT_MAX_TOKENS=800
CONTEXT_MAX_RETRY=2
CONTEXT_TIMEOUT_SECONDS=30

HF_HOME=/home/ai/hungtv/.cache/huggingface